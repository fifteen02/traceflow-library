              "amount": "200 g"
            },
            {
              "item": "Tinned tomatoes",
              "amount": "400 g"
            },
            {
              "item": "Garlic",
              "amount": "2 cloves"
            },
            {
              "item": "Olive oil",
              "amount": "2 tbsp"
            },
            {
              "item": "Basil",
              "amount": "A handful"
            }
          ],
          "steps": [
            {
              "n": 1,
              "text": "Boil salted water and cook the pasta a minute short of the packet time."
            },
            {
              "n": 2,
              "text": "Warm the oil and cook the sliced garlic until just golden."
            },
            {
              "n": 3,
              "text": "Add the tomatoes, simmer for 10 minutes and season."
            },
            {
              "n": 4,
              "text": "Toss the pasta in the sauce with a splash of its water; tear in the basil."
            }
          ]
        },
