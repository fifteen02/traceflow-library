            "text": {
              "@call": "formatCurrency",
              "args": {
                "value": {
                  "@path": "euros"
                },
                "decimals": 0
              }
            }
          },
          {
            "id": "total",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "**Estimated total ${formatCurrency(value: ${/total}, decimals: 0)}**"
