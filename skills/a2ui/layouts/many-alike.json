          },
          {
            "id": "cost-euros#1",
            "component": "Text",
            "text": "€120"
          },
          {
            "id": "costs",
            "component": "Column",
            "children": [
              "cost#0",
              "cost#1"
            ]
          },
          {
            "id": "each",
            "component": "Text",
            "variant": "caption",
            "text": "€1,065 between 3 people"
          },
          {
