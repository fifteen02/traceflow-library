            "variant": "caption"
          },
          {
            "id": "actions",
            "component": "Row",
            "children": [
              "connect"
            ]
          },
          {
            "id": "connect",
            "component": "Button",
            "variant": "primary",
            "child": "connect-label",
            "action": {
              "event": {
                "name": "connect",
                "userMessage": "Connect my Gmail"
              }
            }
          },
          {
            "id": "connect-label",
            "component": "Text",
            "text": "Connect Gmail"
          }
        ]
      }
    }
