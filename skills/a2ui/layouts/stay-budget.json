          "breakfast": 12,
          "total": 426,
          "lines": [
            {
              "what": "Apartment, 2 nights",
              "euros": 378
            },
            {
              "what": "Breakfast, 2 guests × 2 days",
              "euros": 48
            }
          ]
        },
