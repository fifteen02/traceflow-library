              "basis",
              "lines",
              "total",
              "change"
            ]
          },
          {
            "id": "basis",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "${formatCurrency(value: ${/rate}, decimals: 0)} a night for the apartment (up to 2 guests) · breakfast ${formatCurrency(value: ${/breakfast}, decimals: 0)} a guest a day"
              }
            },
            "variant": "caption"
          },
          {
            "id": "lines",
