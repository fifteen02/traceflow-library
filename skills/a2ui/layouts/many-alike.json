            "children": [
              "settle"
            ]
          },
          {
            "id": "settle",
            "component": "Button",
            "variant": "primary",
            "child": "settle-label",
            "action": {
              "event": {
                "name": "settle",
                "userMessage": "Ask the others for their share of €1,065"
              }
            }
          },
          {
