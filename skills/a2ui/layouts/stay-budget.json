            "component": "Button",
            "variant": "default",
            "child": "more-nights-label",
            "action": {
              "event": {
                "name": "more-nights",
                "userMessage": "Estimate it for 3 nights"
              }
            }
          },
          {
            "id": "more-nights-label",
            "component": "Text",
