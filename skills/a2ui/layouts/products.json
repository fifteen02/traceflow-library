{
  "asked": "Anything to make my desk better?",
  "said": "Two upgrades worth a look.",
  "why": "Products from their makers' own pages: brand, name, what it is and the one detail that matters, the pages as sources. No price or photo unless the maker's page has it. \"drawn\" is the surface the app is sent.",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "desk-upgrades",
        "catalogId": "github.com/fifteen02/traceflow:chat/v1",
        "dataModel": {
          "products": [
            {
              "brand": "Sony",
              "name": "WH-1000XM6",
              "what": "Wireless noise-cancelling headphones",
              "detail": "Up to 30 hours with noise cancelling on"
            },
            {
              "brand": "Logitech",
              "name": "MX Master 4",
              "what": "Wireless mouse with haptic feedback",
              "detail": "Customisable controls"
            }
          ]
        },
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": [
              "items",
              "sources"
            ]
          },
          {
            "id": "items",
            "component": "Column",
            "children": {
              "path": "/products",
              "componentId": "product"
            }
          },
          {
            "id": "product",
            "component": "Card",
            "child": "product-facts"
          },
          {
            "id": "product-facts",
            "component": "Column",
            "children": [
              "product-brand",
              "product-name",
              "product-what"
            ]
          },
          {
            "id": "product-brand",
            "component": "Text",
            "text": {
              "@path": "brand"
            },
            "variant": "caption"
          },
          {
            "id": "product-name",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "**${name}**"
              }
            }
          },
          {
            "id": "product-what",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "${what}. ${detail}."
              }
            }
          },
          {
            "id": "sources",
            "component": "Sources",
            "sources": [
              {
                "title": "WH-1000XM6",
                "site": "Sony",
                "url": "https://electronics.sony.com/audio/headphones/headband/p/wh1000xm6-b"
              },
              {
                "title": "MX Master 4",
                "site": "Logitech",
                "url": "https://www.logitech.com/en-eu/shop/p/mx-master-4"
              }
            ]
          }
        ]
      }
    }
