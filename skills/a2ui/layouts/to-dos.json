{
  "asked": "What's on my list?",
  "said": "Three things, one due today.",
  "why": "Open to-dos, soonest first: each with when it is due and a done button, then one to add. Done items are gone, not crossed out. \"drawn\" is the surface the app is sent.",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "to-dos",
        "catalogId": "github.com/fifteen02/traceflow:chat/v1",
        "dataModel": {
          "items": [
            {
              "what": "Renew the car insurance",
              "due": "today"
            },
            {
              "what": "Send Daniel the photos",
              "due": "Friday"
            },
            {
              "what": "Book the dentist",
              "due": "next week"
            }
          ]
        },
        "components": [
          {
            "id": "root",
            "component": "Column",
            "children": [
              "items",
              "actions"
            ]
          },
          {
            "id": "items",
            "component": "Column",
            "children": {
              "path": "/items",
              "componentId": "item"
            }
          },
          {
            "id": "item",
            "component": "Row",
            "children": [
              "item-what",
              "item-done"
            ],
            "justify": "spaceBetween",
            "align": "center"
          },
          {
            "id": "item-what",
            "component": "Text",
            "text": {
              "@call": "formatString",
              "args": {
                "value": "${what} · _${due}_"
              }
            },
            "weight": 1
          },
          {
            "id": "item-done",
            "component": "Button",
            "variant": "borderless",
            "child": "item-done-label",
            "action": {
              "event": {
                "name": "done",
                "userMessage": {
                  "@call": "formatString",
                  "args": {
                    "value": "Mark \"${what}\" as done"
                  }
                }
              }
            }
          },
          {
            "id": "item-done-label",
            "component": "Text",
            "text": "Done"
          },
          {
            "id": "actions",
            "component": "Row",
            "children": [
              "add"
            ]
          },
          {
            "id": "add",
            "component": "Button",
            "variant": "default",
            "child": "add-label",
            "action": {
              "event": {
                "name": "add",
                "userMessage": "Add something to my list"
              }
            }
          },
          {
            "id": "add-label",
            "component": "Text",
            "text": "Add one"
          }
        ]
      }
    }
  ],
