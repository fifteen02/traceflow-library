{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "protocolVersion": "1.0",
  "catalogId": "github.com/fifteen02/traceflow:chat/v1",
  "title": "traceflow chat",
  "description": "What an agent may lay out a reply with in traceflow's chat app: A2UI's basic layout and text pieces (Text, Row, Column, Card, Divider, Button, as the basic catalog has them), A2UI's VegaChart, an Image of a real photo from the web, and the cards traceflow's fixed tools draw (Places, Schedule, Table, Sources). Values are literal, or read from the surface's dataModel: {\"@path\": \"/a/b\"} (relative inside a template), {\"@call\": \"formatCurrency\", \"args\": {...}}, and children {\"path\": \"/items\", \"componentId\": \"item\"} drawn once per item. Nothing writes the data: there are no inputs.",
  "instructions": "Lay a reply out only when it helps the person act or compare: a pick between places, a day with a clash, numbers worth seeing. Say the point in your words first; the surface carries what words can't. One root, ids unique, every child an id of the surface. A Button sends its action.event.userMessage as the person's next message, so write it as they would say it.",
  "components": {
    "Text": {
      "type": "object",
      "description": "Words: a line of the reply (body) or a quiet note (caption). Simple Markdown (bold, italics) only.",
      "properties": {
        "component": { "const": "Text" },
        "text": { "type": "string", "maxLength": 600 },
        "variant": { "type": "string", "enum": ["caption", "body"], "default": "body" },
        "weight": { "$ref": "#/$defs/Weight" }
      },
      "required": ["component", "text"]
    },
    "Row": {
      "type": "object",
      "description": "Children side by side, wrapping when there is no room: a row of buttons.",
      "properties": {
        "component": { "const": "Row" },
        "children": { "$ref": "#/$defs/Children" },
        "justify": { "type": "string", "enum": ["center", "end", "spaceAround", "spaceBetween", "spaceEvenly", "start", "stretch"], "default": "start" },
        "align": { "type": "string", "enum": ["start", "center", "end", "stretch"], "default": "center" },
        "weight": { "$ref": "#/$defs/Weight" }
      },
      "required": ["component", "children"]
    },
    "Column": {
      "type": "object",
      "description": "Children one under another: most surfaces' root.",
      "properties": {
        "component": { "const": "Column" },
        "children": { "$ref": "#/$defs/Children" },
        "justify": { "type": "string", "enum": ["start", "center", "end", "spaceBetween", "spaceAround", "spaceEvenly", "stretch"], "default": "start" },
        "align": { "type": "string", "enum": ["start", "center", "end", "stretch"], "default": "stretch" },
        "weight": { "$ref": "#/$defs/Weight" }
      },
      "required": ["component", "children"]
    },
    "Card": {
      "type": "object",
      "description": "A panel around one child (a Column for several).",
      "properties": {
        "component": { "const": "Card" },
        "child": { "$ref": "#/$defs/Child" },
        "weight": { "$ref": "#/$defs/Weight" }
      },
      "required": ["component", "child"]
    },
    "Divider": {
      "type": "object",
      "description": "A line between parts.",
      "properties": {
        "component": { "const": "Divider" },
        "axis": { "type": "string", "enum": ["horizontal", "vertical"], "default": "horizontal" }
      },
      "required": ["component"]
    },
    "Image": {
      "type": "object",
      "description": "A real photo from the web of what the reply is about, at its https address, or the address of the page it is on (a recipe's, a product's: the page's own photo is shown): the app fetches it and credits its site. Never a made-up picture standing in for a real place or thing.",
      "properties": {
        "component": { "const": "Image" },
        "url": { "type": "string", "maxLength": 2000 },
        "alt": { "type": "string", "maxLength": 200 },
        "caption": { "type": "string", "maxLength": 200 },
        "weight": { "$ref": "#/$defs/Weight" }
      },
      "required": ["component", "url", "alt"]
    },
    "Button": {
      "type": "object",
      "description": "Sends action.event.userMessage as the person's next message when pressed. Its child is a Text: its label. primary for the one thing you recommend, default for the rest.",
      "properties": {
        "component": { "const": "Button" },
        "child": { "$ref": "#/$defs/Child" },
        "variant": { "type": "string", "enum": ["default", "primary", "borderless"], "default": "default" },
        "action": { "$ref": "#/$defs/Action" },
        "weight": { "$ref": "#/$defs/Weight" }
      },
      "required": ["component", "child", "action"]
    },
    "VegaChart": {
      "type": "object",
      "description": "A Vega-Lite chart, drawn live, its data inline.",
      "properties": {
        "component": { "const": "VegaChart" },
        "spec": { "type": "object" },
        "height": { "type": "number", "minimum": 120, "maximum": 600 }
      },
      "required": ["component", "spec"]
    },
    "Places": {
      "type": "object",
      "description": "Places as cards, best first: one place, or several to pick from. Give only what you know of each: leave a rating, price, hours or open-now out rather than writing 0, an empty text or false. The chat adds each place's rating, reviews, price, open-now and today's hours from Google after you send the card: never say you haven't checked them, and asked about them later, read them with a place-details tool rather than guess.",
      "properties": {
        "component": { "const": "Places" },
        "title": { "type": "string" },
        "places": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/Place" } },
        "from": { "$ref": "#/$defs/Spot" }
      },
      "required": ["component", "places"]
    },
    "Schedule": {
      "type": "object",
      "description": "A day or a week of the calendar, in order: each event's start and end as the calendar gives them (2026-11-07T09:00:00+01:00, so the app shows its date and how long it lasts; 09:00 for a day's times alone), a week in one Schedule. place only as the event says it, left out when it has none: never a placeholder such as To be confirmed. people: who else is invited, by the names the calendar gives (its with), the person never among them; invited: how many others in all, when more are invited than named.",
      "properties": {
        "component": { "const": "Schedule" },
        "day": { "type": "string" },
        "summary": { "type": "string" },
        "items": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/ScheduleItem" } }
      },
      "required": ["component", "day", "items"]
    },
    "Compare": {
      "type": "object",
      "description": "Two to four options weighed on one measure (which is cheaper, faster, better): the verdict in a line, each option's figure in the same unit and how it adds up, the best one marked, where the figures came from.",
      "properties": {
        "component": { "const": "Compare" },
        "title": { "type": "string", "maxLength": 120 },
        "verdict": { "type": "string", "maxLength": 300 },
        "options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/Option" } },
        "basis": { "type": "string", "maxLength": 300 }
      },
      "required": ["component", "verdict", "options"]
    },
    "Weather": {
      "type": "object",
      "description": "The weather for one place and day, at a glance: the sky, the temperature with its high and low, the chance of rain and the wind, the day hour by hour, the next few days under it, and whose forecast it is. Asked a yes or no (will it rain?), put the answer in a few words first; asked about the hours (when will it rain? how warm this evening?), fill hours, one an hour or every few, in order. Only figures from a forecast you read: leave out what it doesn't say.",
      "properties": {
        "component": { "const": "Weather" },
        "place": { "type": "string", "maxLength": 60 },
        "day": { "type": "string", "maxLength": 40 },
        "answer": { "type": "string", "maxLength": 60 },
        "condition": { "type": "string", "enum": ["clear", "partly-cloudy", "cloudy", "fog", "drizzle", "rain", "showers", "storm", "snow", "wind"] },
        "summary": { "type": "string", "maxLength": 60 },
        "temperature": { "type": "number" },
        "high": { "type": "number" },
        "low": { "type": "number" },
        "unit": { "type": "string", "enum": ["C", "F"] },
        "rain": { "type": "number", "minimum": 0, "maximum": 100 },
        "wind": { "type": "string", "maxLength": 60 },
        "hours": { "type": "array", "maxItems": 24, "items": { "$ref": "#/$defs/Hour" } },
        "days": { "type": "array", "maxItems": 5, "items": { "$ref": "#/$defs/Day" } },
        "source": { "type": "string", "maxLength": 120 }
      },
      "required": ["component", "place", "day", "condition", "temperature"]
    },
    "Table": {
      "type": "object",
      "description": "Rows of the same shape under their columns.",
      "properties": {
        "component": { "const": "Table" },
        "title": { "type": "string" },
        "columns": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/Column" } },
        "rows": { "type": "array", "maxItems": 50, "items": { "type": "object" } }
      },
      "required": ["component", "columns", "rows"]
    },
    "Sources": {
      "type": "object",
      "description": "Where an answer comes from, in order.",
      "properties": {
        "component": { "const": "Sources" },
        "title": { "type": "string" },
        "sources": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/Citation" } }
      },
      "required": ["component", "sources"]
    },
    "Files": {
      "type": "object",
      "description": "Files the answer is about (a document found in Drive, a sheet shared with them): each with its name, its kind, where it lives and when it changed, opened by its link. Use it instead of writing a file's name and link out.",
      "properties": {
        "component": { "const": "Files" },
        "title": { "type": "string" },
        "files": { "type": "array", "minItems": 1, "maxItems": 10, "items": { "$ref": "#/$defs/File" } }
      },
      "required": ["component", "files"]
    }
  },
  "functions": {
    "formatString": { "description": "Words with ${/path}, ${relative} or ${function(arg: value, ...)} filled in; \\${ for a literal ${.", "args": { "value": "string" } },
    "formatNumber": { "description": "A number as words: 1,240.", "args": { "value": "number", "decimals": "number?", "grouping": "boolean?" } },
    "formatCurrency": { "description": "An amount: €1,065.", "args": { "value": "number", "currency": "string? (EUR)", "decimals": "number?" } },
    "formatDate": { "description": "A date, time or both (2026-11-06, 19:30, 2026-11-06T19:30) as the format says, in Unicode pattern letters: EEEE d MMMM, h:mm a.", "args": { "value": "string", "format": "string" } },
    "pluralize": { "description": "one, other (or zero) by the count.", "args": { "value": "number", "one": "string", "other": "string", "zero": "string?" } },
    "join": { "description": "Items as one line.", "args": { "values": "array", "separator": "string? (, )" } }
  },
  "$defs": {
    "Child": { "type": "string", "description": "The id of a component of the surface." },
    "Children": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/Child" }, "description": "The ids of components of the surface, in order." },
    "Weight": { "type": "number", "minimum": 0 },
    "Action": {
      "type": "object",
      "properties": {
        "event": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "userMessage": { "type": "string", "maxLength": 300 },
            "context": { "type": "object" }
          },
          "required": ["name", "userMessage"],
          "additionalProperties": false
        }
      },
      "required": ["event"],
      "additionalProperties": false
    },
    "Place": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "photo": { "type": "string" },
        "rating": { "type": "number" },
        "reviews": { "type": "integer" },
        "price": { "type": "string" },
        "kind": { "type": "string" },
        "distance": { "type": "string" },
        "openNow": { "type": "boolean" },
        "hours": { "type": "string" },
        "address": { "type": "string" },
        "mapsUrl": { "type": "string" },
        "phone": { "type": "string" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "Spot": {
      "type": "object",
      "properties": { "latitude": { "type": "number" }, "longitude": { "type": "number" } },
      "required": ["latitude", "longitude"],
      "additionalProperties": false
    },
    "Option": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 60 },
        "figure": { "type": "string", "maxLength": 40 },
        "unit": { "type": "string", "maxLength": 40 },
        "how": { "type": "string", "maxLength": 200 },
        "best": { "type": "boolean" }
      },
      "required": ["name", "figure"],
      "additionalProperties": false
    },
    "Day": {
      "type": "object",
      "properties": {
        "day": { "type": "string", "maxLength": 12 },
        "condition": { "type": "string", "enum": ["clear", "partly-cloudy", "cloudy", "fog", "drizzle", "rain", "showers", "storm", "snow", "wind"] },
        "high": { "type": "number" },
        "low": { "type": "number" }
      },
      "required": ["day", "condition", "high"],
      "additionalProperties": false
    },
    "Hour": {
      "type": "object",
      "properties": {
        "time": { "type": "string", "maxLength": 8 },
        "condition": { "type": "string", "enum": ["clear", "partly-cloudy", "cloudy", "fog", "drizzle", "rain", "showers", "storm", "snow", "wind"] },
        "temperature": { "type": "number" },
        "rain": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "required": ["time", "condition", "temperature"],
      "additionalProperties": false
    },
    "ScheduleItem": {
      "type": "object",
      "properties": {
        "start": { "type": "string" },
        "end": { "type": "string" },
        "title": { "type": "string" },
        "place": { "type": "string" },
        "people": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 60 } },
        "invited": { "type": "integer", "minimum": 0 }
      },
      "required": ["start", "title"],
      "additionalProperties": false
    },
    "Column": {
      "type": "object",
      "properties": { "key": { "type": "string" }, "label": { "type": "string" } },
      "required": ["key", "label"],
      "additionalProperties": false
    },
    "File": {
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "The file's name as people read it: its title, without the extension or a run of ids a system added." },
        "kind": { "enum": ["pdf", "doc", "sheet", "slides", "image", "video", "audio", "folder", "archive", "other"] },
        "where": { "type": "string", "description": "Where it lives: a folder, a drive, a site." },
        "changed": { "type": "string", "description": "When it last changed, as an ISO date or date-time." },
        "size": { "type": "string", "description": "How big it is, as people say it: 2.4 MB." },
        "url": { "type": "string", "description": "Its address, to open it." }
      },
      "required": ["name", "kind"],
      "additionalProperties": false
    },
    "Citation": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "url": { "type": "string" },
        "site": { "type": "string" },
        "snippet": { "type": "string" }
      },
      "required": ["title"],
      "additionalProperties": false
    }
  }
}
